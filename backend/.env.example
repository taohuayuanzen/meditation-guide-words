# ─────────────────────────────────────────────
# 冥想引导工作台 — 后端环境变量模板
# ─────────────────────────────────────────────
# 使用方法：复制为 .env 并填入实际值
#   cp .env.example .env
# ─────────────────────────────────────────────

# ---- 数据库 ----
# SQLite 文件路径（相对 backend/ 运行目录）
DATABASE_URL=sqlite:///./data/meditation.db

# ---- 音频输出 ----
AUDIO_OUTPUT_DIR=./data/audio

# ---- 纯音乐文件与 FFmpeg ----
MUSIC_SOURCE_DIR=./data/music/source
MUSIC_FINAL_DIR=./data/music/final
FFPROBE_TIMEOUT_SECONDS=15
FFMPEG_TIMEOUT_SECONDS=900

# ---- Worker ----
WORKER_CONCURRENCY=2

# ---- Dify 集成 ----
# Dify API 基础地址（同机器部署默认 http://localhost/v1）
DIFY_BASE_URL=http://localhost/v1
# App A: 冥想引导词生成 → 在 Dify 工作室 → 访问 API 页面获取
DIFY_SCRIPT_APP_KEY=app-xxxxxxxxxxxxxxxx
# App B: 冥想音频生成 → 在 Dify 工作室 → 访问 API 页面获取
DIFY_AUDIO_APP_KEY=app-xxxxxxxxxxxxxxxx

# ---- LLM（设置页持久化，此处仅作为参考默认值）----
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat

# ---- TTS（设置页持久化，此处仅作为参考默认值）----
